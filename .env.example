# Auth (required for NextAuth)
AUTH_SECRET=your-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3004

# Database: local SQLite (default) or Turso for Vercel
# Leave unset for local file ./local.db
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# Optional: OpenAI for AI suggestions (event title/description/location)
# OPENAI_API_KEY=sk-...
